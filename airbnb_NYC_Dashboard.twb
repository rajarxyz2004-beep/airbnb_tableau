      <aliases enabled='yes' />
      <column caption='review perofmance score' datatype='integer' name='[Calculation_0637497108799488]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Review Scores Rating]*[Number Of Reviews]' />
      </column>
      <column caption='price category' datatype='string' name='[Calculation_0637497109458945]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Price]&gt;300 then &quot;luxury&quot;&#13;&#10;ELSEIF [Price]&gt;150 then &quot;standard&quot;&#13;&#10;ELSE&quot;budget&quot;&#13;&#10;END' />
      </column>
      <column caption='review category' datatype='string' name='[Calculation_0637497111777282]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Number Of Reviews]&gt;100 then &quot;highly reviewed&quot;&#13;&#10;else  &quot;lesss reviewed&quot;&#13;&#10;end' />
      </column>
      <column caption='host status' datatype='string' name='[Calculation_0637497113776131]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  [Host Since]&lt;=TODAY()then &quot;active host&quot;&#13;&#10;ELSE &quot;new host&quot;&#13;&#10;END' />
      </column>
      <column caption='price filter category' datatype='string' name='[Calculation_0637497119756294]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  [Price]&gt;[Parameters].[Parameter 0637497117523973] then &quot;above limit&quot;&#13;&#10;ELSE &quot;below limit&quot;&#13;&#10;END' />
      </column>
      <column datatype='integer' name='[Host Id]' role='dimension' type='ordinal' />
      <column aggregation='Sum' datatype='integer' default-format='*00000' name='[Zipcode]' role='dimension' semantic-role='[ZipCode].[Name]' type='ordinal' />
